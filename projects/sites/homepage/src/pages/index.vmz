<script client>
const BOARD_FORMATS = [
    { name: "kicad_pcb", exportStatus: "unsupported" },
    { name: "gbr", exportStatus: "supported" },
    { name: "drl", exportStatus: "supported" },
    { name: "pos", exportStatus: "supported" },
    { name: "bom", exportStatus: "supported" },
    { name: "step", exportStatus: "unsupported" },
    { name: "ipc2581", exportStatus: "unsupported" },
    { name: "svg", exportStatus: "supported" },
    { name: "pdf", exportStatus: "unsupported" },
    { name: "png", exportStatus: "unsupported" },
];

export default class IndexPage {
    formats = BOARD_FORMATS.map((format) => ({
        name: format.name,
        importStatus: "unsupported",
        editStatus: "unsupported",
        exportStatus: format.exportStatus,
        status: format.exportStatus === "supported" ? "export" : "declared",
        chip: format.exportStatus === "supported" ? "chip chip--ok" : "chip chip--idle",
    }));

    static meta() {
        return {
            title: "OpenPCB — PCB layout, verification and fabrication handoff",
            description:
                "OpenPCB keeps board layout, verification and fabrication handoff on one editable board document for embedded hardware.",
        };
    }
}
</script>




